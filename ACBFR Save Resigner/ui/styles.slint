export global Palette {
    out property <color> bg: #1e1f22;
    out property <color> surface: #2b2d31;
    out property <color> border: #3f4147;
    out property <color> text-primary: #e3e5e8;
    out property <color> text-muted: #949ba4;
    out property <color> accent: #5865f2;
    out property <color> accent-hover: #6f77f5;
    out property <color> danger: #da373c;
    out property <color> success: #23a55a;
}

export global Metrics {
    out property <length> spacing-sm: 6px;
    out property <length> spacing-md: 12px;
    out property <length> spacing-lg: 20px;
    out property <length> radius: 6px;
    out property <length> field-height: 34px;
}
